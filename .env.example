SECRET_KEY=replace-with-your-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Site
SITE_ID=1

DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# Email Settings
EMAIL_BACKEND=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Rate Limiting
OTP_RATE_LIMIT=20/min
LOGIN_RATE_LIMIT=10/min

AI_OUTLINE_RATE_LIMIT=10/min
AI_ARTICLE_RATE_LIMIT=10/min

AI_QUIZ_RATE_LIMIT=10/min
AI_CODING_RATE_LIMIT=10/min

# Google OAuth (authorization-code flow)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/api/v1/auth/google/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_ALLOWED_CLIENT_IDS=

# LinkedIn OAuth (authorization-code flow)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=http://localhost:8000/api/v1/auth/linkedin/callback/

# Frontend URLs
# IMPORTANT: in production this MUST be the real domain. Its value is printed on
# every issued certificate PDF and encoded in the verification QR code — a
# localhost value there produces an unverifiable certificate.
FRONTEND_URL=http://localhost:3000
# Comma-separated list of allowed CORS origins (defaults to FRONTEND_URL if unset)
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_GOOGLE_CALLBACK=http://localhost:3000/auth/google/callback
FRONTEND_LINKEDIN_CALLBACK=http://localhost:3000/auth/linkedin/callback
FRONTEND_ERROR_URL=http://localhost:3000/auth/error
# Frontend path certificate verification URLs are built on (joined onto FRONTEND_URL),
# producing e.g. https://careercollege.com/verify/CC-2026-NEXT-000123
CERTIFICATE_VERIFY_PATH=/verify/

# JWT cookie settings
JWT_COOKIE_SECURE=False
JWT_COOKIE_SAMESITE=Lax
JWT_COOKIE_DOMAIN=
JWT_COOKIE_PATH=/
JWT_ACCESS_COOKIE_NAME=access_token
JWT_REFRESH_COOKIE_NAME=refresh_token

# Celery / Redis — separate db index per concern so a FLUSHDB on one
# does not wipe the others. Requires cluster-mode-DISABLED Redis
# (cluster mode enabled supports db 0 only).
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Django Channels layer. Omit to reuse CELERY_BROKER_URL.
# Must be identical across all daphne replicas and all workers that call group_send.
CHANNEL_LAYERS_URL=redis://127.0.0.1:6379/2

# Media files
MEDIA_URL=/media/
MEDIA_ROOT=media
STATIC_ROOT=staticfiles

# S3 object storage — leave AWS_STORAGE_BUCKET_NAME blank for local dev
# (falls back to local disk). Set it in production to switch default +
# staticfiles storage to S3. Credentials come from the EC2 instance role —
# only set AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY if not running on EC2.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_CUSTOM_DOMAIN=
AWS_LOCATION=media
AWS_S3_REGION_NAME=
AWS_S3_OBJECT_PARAMETERS={"CacheControl": "max-age=86400"}

# CloudFront signed video streaming. Leave CLOUDFRONT_DOMAIN blank in local
# dev — the streaming view falls back to the storage-relative URL. The
# private key ships as a single line with literal `\n` between PEM lines.
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_ID=
CLOUDFRONT_PRIVATE_KEY=
CLOUDFRONT_SIGNED_URL_TTL_SECONDS=7200
# Cookie Domain= for the signed CloudFront cookies. Must be a parent
# domain of the API host AND the CloudFront distribution's custom domain
# (e.g. .niduscareer.com). Leave blank in local dev.
CLOUDFRONT_COOKIE_DOMAIN=

# Multipart direct-to-S3 upload guardrails.
AWS_S3_MAX_UPLOAD_SIZE=5368709120
AWS_S3_MULTIPART_CHUNK_SIZE=5242880
AWS_S3_PRESIGNED_PART_URL_TTL_SECONDS=3600

# Per-user rate limits (DRF format: "N/period"). Tighten in prod as needed.
VIDEO_UPLOAD_INITIATE_RATE_LIMIT=30/hour
VIDEO_STREAM_URL_RATE_LIMIT=120/hour

# Video processing
# Use absolute paths on Windows, for example:

FFMPEG_BINARY_PATH=ffmpeg
FFPROBE_BINARY_PATH=ffprobe

# libx264 (CPU, default) | h264_nvenc (NVIDIA) | h264_qsv (Intel Quick Sync).
# Hardware encoders open one session per rendition — verify the full ladder
# encodes on the worker host before switching.
VIDEO_ENCODER=libx264
# Hard cap on a single ladder run, seconds. Keeps a hung ffmpeg from pinning
# a Celery worker (acks_late only redelivers when the worker dies).
FFMPEG_TIMEOUT_SECONDS=10800
# Parallel HLS segment uploads to storage. Raise on S3, irrelevant locally.
HLS_UPLOAD_CONCURRENCY=8


RUNNER_IMAGE_PYTHON=
RUNNER_IMAGE_JAVASCRIPT=
RUNNER_IMAGE_CPP=
RUNNER_IMAGE_JAVA=
RUNNER_RUNTIME_DEV=runc
RUNNER_RUNTIME_PROD=runsc 

# Co-instructor invite expiry (days)
INSTRUCTOR_INVITE_EXPIRY_DAYS=7

# AI services (the FastAPI project in Career-College-AI-Services).
# These two vars cover EVERY AI feature — a new one only adds a URL path.
# Must be reachable from this backend only, never from the public internet.
AI_SERVICES_BASE_URL=http://localhost:8001
# Shared secret. Must equal SERVICE_API_KEY in the AI services project's .env.
# The provider key (GROQ_API_KEY) lives only there — never set it here.
AI_SERVICES_KEY=

# SSLCommerz payment gateway (sandbox credentials from https://developer.sslcommerz.com)
SSLCOMMERZ_STORE_ID=testbox
SSLCOMMERZ_STORE_PASSWORD=qwerty
SSLCOMMERZ_SANDBOX=True
# Backend base URL for gateway callback URLs (must be publicly reachable for IPN)
BACKEND_URL=http://localhost:8000
# Frontend paths the payment callbacks redirect to (joined onto FRONTEND_URL)
FRONTEND_PAYMENT_SUCCESS_PATH=/payment/success
FRONTEND_PAYMENT_FAIL_PATH=/payment/fail
FRONTEND_PAYMENT_CANCEL_PATH=/payment/cancel
